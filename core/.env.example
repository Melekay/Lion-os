# lion-core – Beispielkonfiguration. Echte Werte stehen in /etc/lion/lion.env (Rechte 600).
LION_SECRET=bitte-mindestens-32-zufaellige-zeichen-eintragen
LION_DB=/var/lib/lion/lion.db
LION_HOST=127.0.0.1
LION_PORT=8080
# Einrichtungscode für den ersten Admin (der Installer erzeugt ihn). Leer = jeder im Netz darf einrichten.
LION_SETUP_CODE=ABCD-EFGH-JKLM

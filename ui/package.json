{
  "name": "lion-ui",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Lion OS – Weboberfläche (statischer Export, spricht nur mit /api)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vorschau": "node scripts/vorschau.mjs",
    "demo:build": "vite build --config demo/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
